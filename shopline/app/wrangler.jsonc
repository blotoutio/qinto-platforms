{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Local only: `wrangler dev` and the vitest pool read this file. Deployed Workers use
  // `wrangler.sandbox.jsonc` and `wrangler.production.jsonc`; keep the three in step.
  "name": "blotout-shopline-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "observability": { "enabled": true },
  // Hourly Blotout grant keep-alive; see `services/grant-keep-alive.ts`.
  "triggers": { "crons": ["23 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blotout-shopline",
      "database_id": "local-blotout-shopline",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  // The SPA. The Worker owns routing, so a request only falls through to an asset when no route matched.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // The dev app and the Qinto sandbox. `.dev.vars` overrides these and holds the secrets:
  // SHOPLINE_APP_SECRET, QINTO_CLIENT_ID, QINTO_CLIENT_SECRET, TOKEN_KEK.
  "vars": {
    "SHOPLINE_APP_KEY": "14827ad8efbfc8855597a1e23a23900c09223001",
    "SHOPLINE_API_HOST": "myshopline.com",
    "QINTO_API_ORIGIN": "https://api.qinto.tech",
    "QINTO_AUTHORIZE_ORIGIN": "https://portal.qinto.tech"
  }
}
