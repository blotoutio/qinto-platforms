{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blotout-shopline",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "observability": { "enabled": true },
  // Hourly Blotout grant keep-alive; see `services/grant-keep-alive.ts`. Inherited by `env.dev`.
  "triggers": { "crons": ["23 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blotout-shopline",
      // Replaced by the id `wrangler d1 create blotout-shopline` prints. Local dev works without it.
      "database_id": "local-blotout-shopline",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  // The SPA. The Worker owns routing, so a request only falls through to an asset when no route matched.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "SHOPLINE_APP_KEY": "",
    "SHOPLINE_API_HOST": "myshopline.com",
    "QINTO_API_ORIGIN": "https://qinto-api.blotout.io",
    "QINTO_AUTHORIZE_ORIGIN": "https://platform.blotout.io"
  },
  // Secrets, never in this file: SHOPLINE_APP_SECRET, QINTO_CLIENT_ID, QINTO_CLIENT_SECRET, TOKEN_KEK.
  // Local dev reads them from .dev.vars; deployments from `wrangler secret put`.
  "env": {
    // `--env dev`. Wrangler does not inherit `d1_databases`, `vars` or secrets into an environment,
    // so each is restated here and every secret needs its own `wrangler secret put <NAME> --env dev`.
    "dev": {
      "name": "blotout-shopline-dev",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "blotout-shopline-dev",
          // Replaced by the id `wrangler d1 create blotout-shopline-dev` prints.
          "database_id": "",
          "migrations_dir": "drizzle/migrations"
        }
      ],
      "vars": {
        "SHOPLINE_APP_KEY": "14827ad8efbfc8855597a1e23a23900c09223001",
        "SHOPLINE_API_HOST": "myshopline.com",
        "QINTO_API_ORIGIN": "https://api.qinto.tech",
        "QINTO_AUTHORIZE_ORIGIN": "https://portal.qinto.tech"
      }
    }
  }
}
