{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Sandbox: the [Sandbox] Blotout SHOPLINE app against the Qinto sandbox. Deployed by the Release
  // workflow with type `sandbox`, or `pnpm --filter app deploy:sandbox`.
  "name": "blotout-shopline-sandbox",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "observability": { "enabled": true },
  // Hourly Blotout grant keep-alive; see `services/grant-keep-alive.ts`.
  "triggers": { "crons": ["23 * * * *"] },
  "routes": [{ "pattern": "shopline-sandbox.qinto.tech", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blotout-shopline-sandbox",
      "database_id": "34c8312c-501e-4ca2-ad68-a0c3df661e0d",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  // The SPA. The Worker owns routing, so a request only falls through to an asset when no route matched.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    // The [Sandbox] Blotout app's key, from the SHOPLINE Partner Portal.
    "SHOPLINE_APP_KEY": "1d8d379979293e0bfdf6b86c39ac37f4cdbaa3bc",
    "SHOPLINE_API_HOST": "myshopline.com",
    "QINTO_API_ORIGIN": "https://api.qinto.tech",
    "QINTO_AUTHORIZE_ORIGIN": "https://portal.qinto.tech"
  }
  // Secrets, set once with `wrangler secret put <NAME> --config wrangler.sandbox.jsonc` and never by
  // the workflow: SHOPLINE_APP_SECRET, QINTO_CLIENT_ID, QINTO_CLIENT_SECRET, TOKEN_KEK.
}
