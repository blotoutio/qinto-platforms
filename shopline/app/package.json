{
  "name": "app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port ${BACKEND_PORT:-3457} --var QINTO_DEV_CALLBACK_ORIGIN:http://localhost:${BACKEND_PORT:-3457}",
    "build": "wrangler deploy --env=\"\" --dry-run --outdir dist",
    "deploy": "wrangler deploy --env=\"\"",
    "deploy:dev": "wrangler deploy --env dev",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:check": "node scripts/db-check.mjs",
    "db:migrate:local": "wrangler d1 migrations apply blotout-shopline --local",
    "db:migrate:remote": "wrangler d1 migrations apply blotout-shopline --remote",
    "db:migrate:dev": "wrangler d1 migrations apply blotout-shopline-dev --env dev --remote",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:",
    "@vitest/coverage-istanbul": "catalog:"
  }
}
