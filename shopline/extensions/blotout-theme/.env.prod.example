# `sl extension push` reads this file — the name is fixed as `.env.<env>`, and the env defaults to
# `prod`. Copy to `.env.prod` and fill in. Never commit the filled copy.
#
# Unlike the pixel extension, the theme path identifies the app by key and secret rather than by a
# prompt (`services/extension/register.js`), so a filled file makes the push non-interactive.
# The first push registers the extension and writes EXTENSION_ID and EXTENSION_UUID back here.
SHOPLINE_APP_KEY=14827ad8efbfc8855597a1e23a23900c09223001
SHOPLINE_APP_SECRET=
# Ignored for a theme app extension: the CLI hardcodes the registered name as `theme-app-extension`
# and rewrites this line to match. Rename in the Partner Portal.
EXTENSION_TITLE=Blotout-custom-code
# The partner organization that owns the app. Without it the CLI prompts, and the prompt needs a TTY.
PARTNER_ID=7336
